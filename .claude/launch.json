{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "portfolio",
      "autoPort": true,
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec python3 -m http.server \"$PORT\""
      ],
      "port": 4173
    },
    {
      "name": "portfolio-next",
      "autoPort": true,
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd \"$HOME/portfolio\" && exec npm run dev"
      ],
      "port": 3000
    }
  ]
}